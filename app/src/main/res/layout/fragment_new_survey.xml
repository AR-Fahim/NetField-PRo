<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_3">

            <!-- Title Header -->
            <TextView
                android:id="@+id/text_screen_title"
                style="@style/TextAppearance.Material3.HeadlineMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screen_s06_title"
                android:textColor="?attr/colorOnSurface" />

            <!-- Stepper Indicator -->
            <TextView
                android:id="@+id/text_step_indicator"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/s06_step1_title"
                android:textColor="?attr/colorPrimary" />

            <!-- STEP 1: Environment -->
            <LinearLayout
                android:id="@+id/layout_step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_env_status"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2">

                        <TextView
                            android:id="@+id/text_env_permission"
                            style="@style/TextAppearance.Material3.BodyLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/text_env_services"
                            style="@style/TextAppearance.Material3.BodyLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/text_env_wifi"
                            style="@style/TextAppearance.Material3.BodyLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/text_env_throttle"
                            style="@style/TextAppearance.Material3.BodyLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:gravity="center_vertical"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dev_options"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/s06_dev_options"
                            android:contentDescription="@string/s06_dev_options"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Issue Card & Fix Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_env_issue"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2">

                        <TextView
                            android:id="@+id/text_env_issue"
                            style="@style/TextAppearance.Material3.BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_env_fix"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/s06_btn_fix"
                            android:contentDescription="@string/s06_btn_fix" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 1 Next Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/s06_btn_next"
                    android:contentDescription="@string/s06_btn_next"
                    android:enabled="false" />

            </LinearLayout>

            <!-- STEP 2: Warm-up (Placeholder for M7s-2) -->
            <LinearLayout
                android:id="@+id/layout_step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_warmup_status"
                    style="@style/TextAppearance.Material3.BodyLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s06_step2_title" />

                <ProgressBar
                    android:id="@+id/progress_warmup"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:max="3"
                    android:progress="0" />

                <TextView
                    android:id="@+id/text_networks_title"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/s06_networks_title" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_networks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:nestedScrollingEnabled="false" />

                <!-- Warm-up Failure Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_warmup_failed"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2">

                        <TextView
                            android:id="@+id/text_warmup_failed"
                            style="@style/TextAppearance.Material3.BodyLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/s06_warmup_failed"
                            android:textColor="?attr/colorError" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_warmup_retry"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/s06_warmup_retry"
                                android:contentDescription="@string/s06_warmup_retry" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_warmup_continue_indicative"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_1"
                                android:minHeight="48dp"
                                android:text="@string/s06_warmup_continue_indicative"
                                android:contentDescription="@string/s06_warmup_continue_indicative" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 2 Next Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step2_next"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/s06_btn_next"
                    android:contentDescription="@string/s06_btn_next"
                    android:enabled="false" />

            </LinearLayout>

            <!-- STEP 3: Details (Placeholder for M7s-3) -->
            <LinearLayout
                android:id="@+id/layout_step3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_survey_name"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/s06_name_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_survey_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/text_profile_label"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/s06_profile_label" />

                <Spinner
                    android:id="@+id/spinner_profile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_1" />

                <TextView
                    android:id="@+id/text_latency_method"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2" />

                <TextView
                    android:id="@+id/text_indicative_warning"
                    style="@style/TextAppearance.Material3.LabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/s06_indicative_only"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_survey"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/s06_btn_start_survey"
                    android:contentDescription="@string/s06_btn_start_survey" />

            </LinearLayout>

            <!-- WalkEveryEdgeTest buttons (for seamless instrumented test compatibility) -->
            <LinearLayout
                android:id="@+id/layout_walk_edges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_3"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_walk_s18"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/edge_to_s18" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_walk_s07"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/edge_to_s07" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
