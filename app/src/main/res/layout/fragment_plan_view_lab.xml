<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_screen_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_2"
        android:text="@string/debug_plan_lab_title"
        android:textAppearance="@style/TextAppearance.NF.Title"
        android:textColor="@color/nf_on_surface" />

    <com.netfieldpro.ui.plan.PlanView
        android:id="@+id/plan_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
