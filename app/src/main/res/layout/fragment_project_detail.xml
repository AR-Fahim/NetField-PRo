<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_2">

    <TextView
        android:id="@+id/text_screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/screen_s03_title"
        android:textAppearance="@style/TextAppearance.NF.Title"
        android:textColor="@color/nf_on_surface"
        android:visibility="visible" />

    <TextView
        android:id="@+id/text_project_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.NF.Title"
        android:textColor="@color/nf_on_surface"
        android:layout_marginBottom="@dimen/space_2" />

    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/project_empty_hint"
            android:textAppearance="@style/TextAppearance.NF.Body"
            android:textColor="@color/nf_on_surface_variant" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_floors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_floor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_primary"
        android:minHeight="@dimen/touch_primary"
        android:minWidth="@dimen/touch_primary"
        android:text="@string/floor_add"
        android:textAppearance="@style/TextAppearance.NF.Title"
        android:layout_marginTop="@dimen/space_2" />

</LinearLayout>
