<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nf_surface">

    <!-- Top bar / header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="@dimen/space_1">

        <TextView
            android:id="@+id/text_heatmap_header"
            style="@style/TextAppearance.NF.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/nf_on_surface"
            android:text="@string/screen_s09_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sample_report"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:minHeight="@dimen/touch_min"
            android:layout_marginEnd="@dimen/space_1"
            android:text="@string/btn_sample_report"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_palette"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:minHeight="@dimen/touch_min"
            android:minWidth="@dimen/touch_min"
            android:text="@string/btn_palette"
            android:contentDescription="@string/btn_palette" />
    </LinearLayout>

    <!-- Layer chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/space_2">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_layers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_layer_coverage"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:checked="true"
                android:text="@string/layer_coverage" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_layer_24"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="@string/layer_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_layer_5"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="@string/layer_5" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_layer_6"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="@string/layer_6" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_layer_latency"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="@string/layer_latency" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Plan view container with loading spinner & empty hint -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.netfieldpro.ui.plan.PlanView
            android:id="@+id/plan_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_empty"
            style="@style/TextAppearance.NF.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/nf_on_surface_variant"
            android:text="@string/heatmap_empty"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Legend bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="@dimen/space_1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/legend_row_1"
                style="@style/TextAppearance.NF.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:textColor="@color/nf_on_surface"
                android:text="@string/legend_row_1_rssi" />

            <TextView
                android:id="@+id/legend_row_2"
                style="@style/TextAppearance.NF.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:textColor="@color/nf_on_surface"
                android:text="@string/legend_row_2_rssi" />

            <TextView
                android:id="@+id/legend_row_3"
                style="@style/TextAppearance.NF.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:textColor="@color/nf_on_surface"
                android:text="@string/legend_row_3_rssi" />

            <TextView
                android:id="@+id/legend_row_4"
                style="@style/TextAppearance.NF.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:textColor="@color/nf_on_surface"
                android:text="@string/legend_row_4_rssi" />

            <TextView
                android:id="@+id/legend_row_5"
                style="@style/TextAppearance.NF.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nf_on_surface"
                android:text="@string/legend_row_5_rssi" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Status row: Verdict chip & Cells count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="@dimen/space_1">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_verdict"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/nf_on_surface"
            android:text="@string/verdict_placeholder" />

        <TextView
            android:id="@+id/text_cells"
            style="@style/TextAppearance.NF.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:textColor="@color/nf_on_surface_variant"
            android:text="@string/cells_zero" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_geometry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_primary"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_1"
            android:minHeight="@dimen/touch_min"
            android:text="@string/btn_edit_geometry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_finalize"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_primary"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_1"
            android:minHeight="@dimen/touch_min"
            android:text="@string/btn_finalize" />
    </LinearLayout>

</LinearLayout>
