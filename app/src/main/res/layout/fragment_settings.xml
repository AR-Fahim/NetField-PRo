<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_screen_title"
        style="@style/TextAppearance.NF.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:text="@string/screen_s19_title"
        android:textColor="?attr/colorOnSurface" />

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

        <!-- 1. Plan Section -->
        <TextView
            style="@style/TextAppearance.NF.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/settings_section_plan"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/row_manage_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.NF.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_manage_plan"
                android:textColor="?attr/colorOnSurface" />

            <com.netfieldpro.ui.TierBadgeView
                android:id="@+id/tier_badge_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tier_free"
                android:contentDescription="@string/tier_badge_desc" />
        </LinearLayout>

        <!-- 2. Appearance Section -->
        <TextView
            style="@style/TextAppearance.NF.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/settings_section_appearance"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            style="@style/TextAppearance.NF.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/settings_theme"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <RadioGroup
            android:id="@+id/rg_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_theme_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_system" />

            <RadioButton
                android:id="@+id/rb_theme_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_light" />

            <RadioButton
                android:id="@+id/rb_theme_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_dark" />
        </RadioGroup>

        <TextView
            style="@style/TextAppearance.NF.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/settings_palette"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <RadioGroup
            android:id="@+id/rg_palette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_palette_traffic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/palette_traffic" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/swatch_tl_1"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp" />

                    <View
                        android:id="@+id/swatch_tl_2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp" />

                    <View
                        android:id="@+id/swatch_tl_3"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp" />

                    <View
                        android:id="@+id/swatch_tl_4"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp" />

                    <View
                        android:id="@+id/swatch_tl_5"
                        android:layout_width="12dp"
                        android:layout_height="12dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_palette_viridis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/palette_viridis" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/swatch_vi_1"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp" />

                    <View
                        android:id="@+id/swatch_vi_2"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp" />

                    <View
                        android:id="@+id/swatch_vi_3"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp" />

                    <View
                        android:id="@+id/swatch_vi_4"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp" />

                    <View
                        android:id="@+id/swatch_vi_5"
                        android:layout_width="12dp"
                        android:layout_height="12dp" />
                </LinearLayout>
            </LinearLayout>
        </RadioGroup>

        <!-- 3. Device Section -->
        <TextView
            style="@style/TextAppearance.NF.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/settings_section_device"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/row_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.NF.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_diagnostics"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- 4. Profiles Section -->
        <TextView
            style="@style/TextAppearance.NF.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/settings_section_profiles"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/row_custom_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.NF.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_custom_profiles"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/badge_custom_profiles_lock"
                style="@style/TextAppearance.NF.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:text="@string/badge_pro"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 5. About Section -->
        <TextView
            style="@style/TextAppearance.NF.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/settings_section_about"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.NF.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_version"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/text_version"
                style="@style/TextAppearance.NF.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/settings_version"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- 6. Extensions Section (M0 plugin surface) -->
        <LinearLayout
            android:id="@+id/layout_extensions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.NF.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_extensions_title"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/layout_extension_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
</LinearLayout>

