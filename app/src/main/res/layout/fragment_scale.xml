<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_2">

        <TextView
            android:id="@+id/text_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scale_title"
            android:textAppearance="@style/TextAppearance.NF.Title"
            android:textColor="@color/nf_on_surface"
            android:layout_marginBottom="@dimen/space_1" />

        <TextView
            android:id="@+id/text_scale_locked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scale_locked"
            android:textAppearance="@style/TextAppearance.NF.Body"
            android:textColor="@color/nf_error"
            android:layout_marginBottom="@dimen/space_1"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/group_scale_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_1">

            <RadioButton
                android:id="@+id/radio_mode_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="@dimen/touch_min"
                android:minWidth="@dimen/touch_min"
                android:text="@string/scale_mode_line" />

            <RadioButton
                android:id="@+id/radio_mode_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:minHeight="@dimen/touch_min"
                android:minWidth="@dimen/touch_min"
                android:text="@string/scale_mode_width" />
        </RadioGroup>

        <FrameLayout
            android:id="@+id/layout_plan_container"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="@dimen/space_1">

            <com.netfieldpro.ui.plan.PlanView
                android:id="@+id/plan_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manual_points"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/scale_enter_points_manually" />

        <LinearLayout
            android:id="@+id/layout_manual_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_p1_x"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="P1 X (px)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_p1_x"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_p1_y"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_1"
                    android:hint="P1 Y (px)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_p1_y"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_p2_x"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="P2 X (px)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_p2_x"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_p2_y"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_1"
                    android:hint="P2 Y (px)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_p2_y"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:hint="@string/scale_distance_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/text_scale_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.NF.Body"
            android:textColor="@color/nf_error"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_scale_readout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.NF.Title"
            android:textColor="@color/nf_primary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_scale"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_primary"
            android:minHeight="@dimen/touch_primary"
            android:layout_marginTop="@dimen/space_2"
            android:enabled="false"
            android:text="@string/scale_save" />

    </LinearLayout>

</ScrollView>
