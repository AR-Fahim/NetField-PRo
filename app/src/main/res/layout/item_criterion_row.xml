<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_1"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/text_crit_name"
        style="@style/TextAppearance.NF.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:textColor="@color/nf_on_surface" />

    <TextView
        android:id="@+id/text_crit_required"
        style="@style/TextAppearance.NF.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:textColor="@color/nf_on_surface_variant" />

    <TextView
        android:id="@+id/text_crit_measured"
        style="@style/TextAppearance.NF.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:textColor="@color/nf_on_surface" />

    <TextView
        android:id="@+id/text_crit_status"
        style="@style/TextAppearance.NF.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:textColor="@color/nf_on_surface" />

</LinearLayout>
