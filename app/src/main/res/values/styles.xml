<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.NF.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">36sp</item>
        <item name="lineHeight">36sp</item>
    </style>

    <style name="TextAppearance.NF.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:lineHeight">28sp</item>
        <item name="lineHeight">28sp</item>
    </style>

    <style name="TextAppearance.NF.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="lineHeight">24sp</item>
    </style>

    <style name="TextAppearance.NF.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.NF.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="TextAppearance.NF.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
    </style>

    <!-- Verdict Chip Styles: outline-only -->
    <style name="Widget.NF.Chip.Verdict.Pass" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@color/nf_primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/nf_primary</item>
        <item name="chipCornerRadius">@dimen/radius_chip</item>
    </style>

    <style name="Widget.NF.Chip.Verdict.Fail" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@color/nf_error</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/nf_error</item>
        <item name="chipCornerRadius">@dimen/radius_chip</item>
    </style>

    <style name="Widget.NF.Chip.Verdict.Incomplete" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@color/nf_warning</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/nf_warning</item>
        <item name="chipCornerRadius">@dimen/radius_chip</item>
    </style>

    <style name="Widget.NF.Chip.Verdict.NotEligible" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@color/nf_on_surface_variant</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/nf_on_surface_variant</item>
        <item name="chipCornerRadius">@dimen/radius_chip</item>
    </style>
</resources>

